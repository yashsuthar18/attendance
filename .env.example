# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Generate separate values using: openssl rand -hex 32
MEMBER_ACCESS_PEPPER=REPLACE_WITH_64_RANDOM_HEX_CHARS
MEMBER_SESSION_SECRET=REPLACE_WITH_ANOTHER_64_RANDOM_HEX_CHARS

# Optional, server-only key for initial organizer password setup.
# Leave unset after setup to disable the setup-password endpoint.
ORGANIZER_SETUP_KEY=
